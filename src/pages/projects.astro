---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" description="Open-source projects by Tatsat Pandey, including agent-arbiter, TokenLens, PromptSentry and LedgerLM.">
  <header class="wrap page-head">
    <p class="eyebrow">Projects</p>
    <h1>Projects</h1>
    <p>Side projects and open-source tools.</p>
  </header>
  <section class="wrap grid">
    {projects.map(({ data }) => (
      <article class="card">
        <h2>{data.name}</h2>
        {data.publishedOn && <p class="muted pub">Published on {data.publishedOn}</p>}
        {data.summary && <p>{data.summary}</p>}
        {data.tags.length > 0 && <ul class="tags">{data.tags.map((t) => <li>{t}</li>)}</ul>}
        {(data.repoUrl || data.liveUrl) && (
          <p class="links">
            {data.repoUrl && <a href={data.repoUrl} rel="noopener">Source<span class="sr-only"> code for {data.name}</span></a>}
            {data.liveUrl && <a href={data.liveUrl} rel="noopener">{data.publishedOn ?? 'Live'}<span class="sr-only"> page for {data.name}</span></a>}
          </p>
        )}
      </article>
    ))}
  </section>
</Base>
<style>
  .grid { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); padding-top: 0; }
  .grid h2 { font-size: var(--step-1); margin-bottom: var(--space-2); }
  .pub { font-size: var(--step--1); }
  .links { display: flex; gap: var(--space-4); margin: var(--space-3) 0 0; }
  .links a { display: inline-block; padding-block: 0.5rem; font-weight: 600; }
</style>
