---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
const items = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(items.map(async (i) => ({ ...i, Content: (await render(i)).Content })));
---
<Base title="Work" description="Engineering work by Tatsat Pandey: GenAI platform engineering, an SDLC agentic framework, GitHub Copilot enablement and a microservices billing platform.">
  <header class="wrap page-head">
    <p class="eyebrow">Work</p>
    <h1>Engineering work</h1>
    <p>Platforms and tools that help engineering teams ship faster with AI.</p>
  </header>
  <section class="wrap list">
    {rendered.map(({ data, Content }) => (
      <article class="card">
        <h2>{data.title}</h2>
        <p>{data.summary}</p>
        <Content />
        {data.tags.length > 0 && <ul class="tags">{data.tags.map((t) => <li>{t}</li>)}</ul>}
      </article>
    ))}
  </section>
</Base>
<style>
  .list { display: grid; gap: var(--space-3); padding-top: 0; }
  .list h2 { font-size: var(--step-1); }
  .list p { margin: 0; }
</style>
