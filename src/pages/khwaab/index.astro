---
import Base from '../../layouts/Base.astro';
import KhwaabArt from '../../components/KhwaabArt.astro';
import Embed from '../../components/Embed.astro';
import PlatformButtons from '../../components/PlatformButtons.astro';
import { podcast, platforms } from '../../config/links';
import { getEpisodes, ytThumb, ytEmbed, ytWatch, formatDate } from '../../lib/episodes';

const episodes = await getEpisodes();
const latest = episodes[0];
const spotify = platforms.find((p) => p.id === 'spotify')!;
const apple = platforms.find((p) => p.id === 'apple')!;
const youtube = platforms.find((p) => p.id === 'youtube')!;
---
<Base
  theme="khwaab"
  scriptFont
  title={podcast.name}
  description={`${podcast.name}: a Hindi poetry podcast by Tatsat Pandey. ${podcast.tagline} Listen on YouTube, Spotify, Apple Podcasts, JioSaavn and Amazon Music.`}
  image="/og/khwaab.png"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Hindi poetry podcast</p>
        <h1>{podcast.name}</h1>
        <p class="script">{podcast.tagline}</p>
        <PlatformButtons />
      </div>
      <KhwaabArt class="hero-art" />
    </div>
  </section>

  {latest && (
    <section class="wrap" aria-labelledby="latest-h">
      <p class="eyebrow">Latest episode</p>
      <h2 id="latest-h"><a href={`/khwaab/${latest.id}`}>{latest.data.title}</a></h2>
      {latest.data.date && <p class="muted"><time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time></p>}
      <p>{latest.data.description}</p>
      {latest.data.youtubeId && (
        <div class="player">
          <Embed
            href={ytWatch(latest.data.youtubeId)}
            embed={ytEmbed(latest.data.youtubeId)}
            thumb={ytThumb(latest.data.youtubeId)}
            title={`${latest.data.title} on YouTube`}
            label={`Watch “${latest.data.title}”`}
          />
        </div>
      )}
    </section>
  )}

  <section class="wrap" aria-labelledby="listen-h">
    <h2 id="listen-h">Listen</h2>
    <p class="muted">These players always show the newest episodes.</p>
    <div class="players">
      <Embed
        kind="audio"
        href={spotify.url}
        embed={`https://open.spotify.com/embed/show/${podcast.spotifyShowId}?theme=0`}
        title={`${podcast.platformName} on Spotify`}
        label="Play on Spotify"
        height={352}
      />
      <Embed
        kind="audio"
        href={apple.url}
        embed={`https://embed.podcasts.apple.com/in/podcast/surkhaab/id${podcast.appleId}`}
        title={`${podcast.platformName} on Apple Podcasts`}
        label="Play on Apple Podcasts"
        height={352}
      />
    </div>
    <p><a class="btn ghost" href={youtube.url} rel="noopener">All episodes on YouTube</a></p>
  </section>

  <section class="wrap" aria-labelledby="eps-h">
    <h2 id="eps-h">Episodes</h2>
    <ol class="episodes">
      {episodes.map((ep) => (
        <li class="card">
          <a href={`/khwaab/${ep.id}`}><strong>{ep.data.title}</strong></a>
          {ep.data.date && <span class="muted"> · {formatDate(ep.data.date)}</span>}
          <p class="muted">{ep.data.description}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap narrow" aria-labelledby="about-h">
    <h2 id="about-h">About the show</h2>
    <p>{podcast.name} is a Hindi poetry podcast written and read by Tatsat Pandey.</p>
    <!-- TODO(Tatsat): a few lines about the show in your own words. -->
  </section>
</Base>

<style>
  .hero { background: radial-gradient(120% 90% at 80% 10%, #5a2448 0%, var(--dusk) 60%); padding-block: var(--space-5); }
  .hero-grid { display: grid; gap: var(--space-5); align-items: center; }
  .hero h1 { font-size: var(--step-4); margin-bottom: var(--space-2); }
  .hero-copy .eyebrow { color: #f0cfb2; }
  .script { font-family: var(--font-script); font-size: var(--step-3); line-height: 1.1; color: var(--amber); margin-bottom: var(--space-4); }
  .hero-art { width: 100%; max-width: 30rem; justify-self: center; border-radius: 24px; box-shadow: 0 20px 60px rgb(0 0 0 / 0.45); }
  @media (min-width: 52rem) { .hero-grid { grid-template-columns: 1.1fr 1fr; } }

  h2 a { text-decoration: none; }
  h2 a:hover { text-decoration: underline; }
  .player { max-width: 52rem; }
  .players { display: grid; gap: var(--space-3); margin-bottom: var(--space-4); }
  @media (min-width: 52rem) { .players { grid-template-columns: 1fr 1fr; } }
  .episodes { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); }
  .episodes p { margin: var(--space-1) 0 0; }
</style>
