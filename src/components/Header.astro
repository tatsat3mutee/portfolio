---
const { theme = 'default' } = Astro.props as { theme?: string };
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/projects', label: 'Projects' },
  { href: '/research', label: 'Research' },
  { href: '/khwaab', label: 'Khwaab' },
];
---
<header class:list={['site-header', theme]}>
  <div class="wrap bar">
    <a class="name" href="/">Tatsat Pandey</a>
    <nav aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<style>
  .site-header { border-bottom: 1px solid var(--line); }
  .site-header.khwaab { border-color: rgb(255 255 255 / 0.12); background: var(--dusk); color: var(--cream); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-4); padding-block: var(--space-3); }
  .name { font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); text-decoration: none; }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); list-style: none; margin: 0; padding: 0; }
  nav a { text-decoration: none; padding: 0.6rem 0.15rem; display: inline-block; }
  nav a:hover, nav a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 2px; }
</style>
