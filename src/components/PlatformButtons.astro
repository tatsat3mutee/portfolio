---
import { visiblePlatforms, type Platform } from '../config/links';
// Optional per-episode overrides: { spotify: 'https://...' }
const { overrides = {} } = Astro.props as { overrides?: Record<string, string | undefined> };
const list: Platform[] = visiblePlatforms.map((p) => ({ ...p, url: overrides[p.id] || p.url }));
---
<ul class="platforms">
  {list.map((p) => (
    <li><a class={`pf pf-${p.id}`} href={p.url} rel="noopener">{p.label}</a></li>
  ))}
</ul>
<style>
  .platforms { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; padding: 0; margin: 0; }
  .pf {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px;
    padding: 0.5rem 1rem; border-radius: 999px; text-decoration: none; font-weight: 600;
    background: rgb(255 255 255 / 0.08); color: var(--cream); border: 1px solid rgb(255 255 255 / 0.22);
  }
  .pf::before { content: ''; width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--dot, var(--amber)); }
  .pf:hover { background: rgb(255 255 255 / 0.16); }
  .pf-youtube { --dot: #ff3b30; }
  .pf-spotify { --dot: #1ed760; }
  .pf-apple { --dot: #b968f2; }
  .pf-jiosaavn { --dot: #2bc5b4; }
  .pf-amazon { --dot: #25d1da; }
  .pf-instagram { --dot: #e1306c; }
</style>
