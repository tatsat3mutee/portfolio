---
import { social, site } from '../config/links';
const { theme = 'default' } = Astro.props as { theme?: string };
const links = [
  { label: 'GitHub', url: social.github },
  { label: 'LinkedIn', url: social.linkedin },
  { label: 'Instagram', url: social.instagram },
  { label: 'YouTube', url: social.youtube },
  { label: 'Email', url: site.email ? `mailto:${site.email}` : '' },
].filter((l) => l.url);
---
<footer class:list={['site-footer', theme]}>
  <div class="wrap row">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <ul>
      {links.map((l) => (
        <li><a href={l.url} rel={l.url.startsWith('http') ? 'me noopener' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); margin-top: var(--space-6); font-size: var(--step--1); color: var(--muted); }
  .site-footer.khwaab { margin-top: 0; background: var(--dusk); color: #e9d3c0; border-color: rgb(255 255 255 / 0.12); }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-3); padding-block: var(--space-4); }
  .row p { margin: 0; }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); list-style: none; padding: 0; margin: 0; }
  a { display: inline-block; padding-block: 0.6rem; }
</style>
